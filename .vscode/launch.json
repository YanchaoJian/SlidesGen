{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run SlidesGen Pipeline",
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "console": "integratedTerminal",
            "program": "main.py",
            "args": [
                // [Required] Path to the input academic paper PDF
                "--pdf_path", "assets/paper.pdf",
                // [Required] Path to the reference style image for theme extraction
                "--style_image_path", "assets/ref-style-img.png",
                // [Optional] Root output directory (default: output/)
                "--output_dir", "output/",
                // [Optional] Default LLM model, fallback for all stages (default: gpt-4o)
                "--model_name", "MS",
                // [Optional] Per-stage model overrides (default: use --model_name)
                "--vision_model", "moonshotai/Kimi-K2.5",
                "--svg_model", "MiniMax/MiniMax-M2.5",
                "--text_model", "deepseek-ai/DeepSeek-V3.2",
                // [Optional] Path to local Marker model for PDF parsing (default: models/marker)
                "--marker_path", "models/marker",
                // [Optional] Unified retry limit for ALL LLM-related loops
                // (style check / SVG gen+validate / design critique / ChatOpenAI SDK). Default: 3
                "--llm_max_retries", "3",
                // [Optional] Skip human-in-the-loop review steps
                "--skip_plan_review",
                "--skip_pptx_review",
                // [Optional] Enable debug-level logging
                // "--verbose",
                // [Optional] Resume an interrupted session by specifying its thread ID
                // "--thread_id", "0407_0059",
            ]
        }
    ]
}