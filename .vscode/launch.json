{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run SlidesGen Pipeline",
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "console": "integratedTerminal",
            "program": "main.py",
            "args": [
                // [Required] Path to the input academic paper PDF
                "--pdf_path", "assets/paper.pdf",
                // [Required] Path to the reference style image for theme extraction
                "--style_image_path", "assets/ref-style-img.png",
                // [Optional] Root output directory (default: output/)
                "--output_dir", "output/",
                // [Optional] Default LLM model, fallback for all stages (default: gpt-4o)
                "--model_name", "gpt-5-mini",
                // [Optional] Per-stage model overrides (default: use --model_name)
                // "--vision_model", "Qwen/Qwen3-VL-8B-Instruct",
                // "--svg_model", "gpt-5-mini",
                // "--text_model", "deepseek-ai/DeepSeek-R1-Distill-Qwen-7B",
                // [Optional] Path to local Marker model for PDF parsing (default: models/marker)
                "--marker_path", "models/marker",
                // [Optional] Unified retry limit for ALL LLM-related loops
                // (style check / SVG gen+validate / design critique / ChatOpenAI SDK). Default: 3
                "--llm_max_retries", "3",
                // [Optional] Skip human-in-the-loop review steps
                "--skip_plan_review",
                "--skip_pptx_review",
                // [Optional] Enable debug-level logging
                // "--verbose",
                // [Optional] Resume an interrupted session by specifying its thread ID
                // "--thread_id", "0408_1155_MS",
            ]
        },
        {
            "name": "Evaluate PPTX (LLM-as-Judge)",
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "console": "integratedTerminal",
            "program": "metrics/evaluate.py",
            "args": [
                // [Required] Path to the PPTX file to evaluate
                "--pptx_path", "output/SESSION_ID/result/Final_Presentation.pptx",
                // [Optional] Reference style image (enables D3 style transfer scoring)
                "--style_image_path", "assets/ref-style-img.png",
                // [Optional] Vision model for evaluation (default: gpt-4o)
                "--model_name", "gpt-4o",
                // [Optional] DPI for slide rendering (default: 200)
                "--dpi", "200",
                // [Optional] Custom output directory for eval results
                // "--output_dir", "output/SESSION_ID/metrics/eval",
            ]
        },
        {
            "name": "Parse Run Stats (Markdown Report)",
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "console": "integratedTerminal",
            "program": "metrics/parse_logs.py",
            "args": [
                // [Required] Session ID (output subdirectory name)
                "--session_id", "SESSION_ID",
                // [Optional] Output root directory (default: output)
                "--output_dir", "output"
            ]
        },
        {
            "name": "Visualize Workflow Graph",
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "console": "integratedTerminal",
            "program": "scripts/visualize_workflow.py"
        }
    ]
}
